{
  "manifest_version": 3,
  "name": "Discord GIF Machine",
  "version": "1.0.0",
  "description": "Converta vídeos e tweets do Twitter/X em GIFs otimizados (≤ 8MB) para envio no Discord, com suporte a legendas estilo meme.",

  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_title": "Discord GIF Machine"
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],

  "host_permissions": [
    "https://api.vxtwitter.com/*",
    "https://api.fxtwitter.com/*",
    "https://cdn.syndication.twimg.com/*",
    "https://video.twimg.com/*",
    "https://pbs.twimg.com/*",
    "https://corsproxy.io/*",
    "https://api.allorigins.win/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' blob: data: https://*.twimg.com https://pbs.twimg.com https://abs.twimg.com;"
  }
}
